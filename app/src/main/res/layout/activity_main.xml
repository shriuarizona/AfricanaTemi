<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/starnight"
    tools:context=".MainActivity">

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

            <Button
                android:id="@+id/tour_button"
                android:text="@string/culture_walk"
                app:cornerRadius="30dp"
                style="@style/dashboard_button" />

            <Button
                android:id="@+id/courses_button"
                android:text="@string/courses"
                app:cornerRadius="30dp"
                style="@style/dashboard_button" />

            <Button
                android:id="@+id/events_button"
                android:text="@string/events"
                app:cornerRadius="30dp"
                style="@style/dashboard_button" />

            <Button
                android:id="@+id/info_button"
                style="@style/dashboard_button"
                android:text="@string/info"
                app:cornerRadius="30dp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

            <Button
                android:id="@+id/professors_button"
                style="@style/dashboard_button"
                android:text="@string/professors"
                app:cornerRadius="30dp" />

            <Button
                android:id="@+id/alumni_button"
                style="@style/dashboard_button"
                android:text="@string/alumni"
                app:cornerRadius="30dp" />

            <Button
                android:id="@+id/news_button"
                style="@style/dashboard_button"
                android:text="@string/news"
                app:cornerRadius="30dp" />

            <Button
                android:id="@+id/leave_feedback_button"
                android:text="Leave Feedback"
                app:cornerRadius="30dp"
                style="@style/dashboard_button" />

        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>